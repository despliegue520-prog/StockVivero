# En local: usar la External Database URL de Render
# En Render: usar la Internal Database URL
DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_db

# true si usás la External Database URL (conexión desde tu PC)
DB_SSL=true

PORT=3000

# Si lo definís, todas las rutas (menos /health) exigen el header x-api-key
API_KEY=

# true permite que una salida deje el stock en negativo
ALLOW_NEGATIVE=false
